{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@game/*": ["src/game/*"],
      "@render/*": ["src/render/*"],
      "@app/*": ["src/app/*"],
      "@progress/*": ["src/progress/*"],
      "@theme/*": ["src/theme/*"]
    }
  },
  "include": ["src", "tests"],
  // See tsconfig.game.json: the boundary fixtures belong to no project on purpose.
  "exclude": ["src/game/__fixtures__"]
}

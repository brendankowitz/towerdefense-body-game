{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // Our own sources are still checked against a DOM-free lib — that is the gate.
    // Dependencies' declarations legitimately reference DOM types and are not our concern.
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": { "@game/*": ["src/game/*"] }
  },
  // The boundary fixtures are deliberate rule violations, linted by tests/lint/boundaries.test.ts
  // and compiled by nothing. Keeping them out of every project is what lets ESLint parse them
  // without type information, which is the only way a Pixi import can sit under src/game/ at all.
  "include": ["src/game/**/*.ts"],
  "exclude": ["src/game/__fixtures__"]
}
